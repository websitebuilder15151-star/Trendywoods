{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trendywoods",
  "compatibility_date": "2026-10-30",
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "trendywoods",
      "remote": true
    }
  ]
}
